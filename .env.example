# Printful accepts either name. Set exactly one locally and in Netlify.
PRINTFUL_API_KEY=
PRINTFUL_TOKEN=
# Enter the approved VertiFlow store ID (15558986) outside this committed example.
PRINTFUL_STORE_ID=

# Stripe checkout currently requires matching test-mode keys.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SHIPPING_RATE_ID=

# Server-held access token (32+ characters) required for test Checkout and fulfillment.
VERTIFLOW_TEST_ACCESS_TOKEN=

# Server-only EmailJS credentials and two distinct authenticated templates.
EMAILJS_SERVICE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
EMAILJS_CUSTOMER_TEMPLATE_ID=
EMAILJS_OWNER_TEMPLATE_ID=

# Public base URL used for Stripe return URLs.
SITE_URL=

# Optional: a non-empty customer promo must match both values.
VERTIFLOW_PROMO_CODE=
STRIPE_PROMOTION_CODE_ID=
