{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vertiflow.fr/schemas/products.schema.json",
  "title": "VertiFlow commercial product catalogue",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "currency", "products"],
  "properties": {
    "schema_version": { "const": 2 },
    "generated_at": { "type": "string", "format": "date-time" },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "products": { "type": "array", "minItems": 9, "items": { "$ref": "#/$defs/product" } }
  },
  "$defs": {
    "nullableString": { "type": ["string", "null"] },
    "modeKeyedStripeId": {
      "oneOf": [
        { "$ref": "#/$defs/nullableString" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["test", "live"],
          "properties": {
            "test": { "$ref": "#/$defs/nullableString" },
            "live": { "$ref": "#/$defs/nullableString" }
          }
        }
      ]
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slug", "name", "price", "printful_sync_product_ids", "stripe_product_id", "variants"],
      "properties": {
        "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "name": { "type": "string", "minLength": 1 },
        "price": { "type": "string", "pattern": "^[0-9]+\\.[0-9]{2}$" },
        "printful_sync_product_ids": { "type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": { "type": "integer", "minimum": 1 } },
        "stripe_product_id": { "$ref": "#/$defs/modeKeyedStripeId" },
        "variants": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/variant" } }
      }
    },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["color", "size", "printful_color", "printful_size", "printful_sync_product_id", "printful_sync_variant_id", "printful_catalog_variant_id", "stripe_price_id", "image_url", "active"],
      "properties": {
        "color": { "type": "string", "minLength": 1 },
        "size": { "type": "string", "minLength": 1 },
        "printful_color": { "$ref": "#/$defs/nullableString" },
        "printful_size": { "$ref": "#/$defs/nullableString" },
        "printful_sync_product_id": { "type": "integer", "minimum": 1 },
        "printful_sync_variant_id": { "type": "integer", "minimum": 1 },
        "printful_catalog_variant_id": { "type": "integer", "minimum": 1 },
        "stripe_price_id": { "$ref": "#/$defs/modeKeyedStripeId" },
        "image_url": { "$ref": "#/$defs/nullableString" },
        "active": { "const": true }
      }
    }
  }
}
